<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkTimeCalculatorAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="400"
        x:Class="WorkTimeCalculatorAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Work Time Calculator"
        Width="350" Height="400" CanResize="False">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Avalonia's Fluent theme sets a MinHeight of 32 on these controls; the WPF layout uses 24 -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="76"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="74"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Überschrift über den Registerkarten -->
        <TextBlock Grid.Row="0" Text="Work Time Calculator" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10,0,10"/>

        <TabControl Grid.Row="1">

            <!-- Tab 1: Work Time -->
            <TabItem Header="Work Time Calculator">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                        <RadioButton Content="Calculate Work Time" IsChecked="{Binding IsWorkTimeMode}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <RadioButton Content="Calculate Go Home Time" IsChecked="{Binding IsGoHomeTimeMode}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Start:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,63,0,0"/>
                    <TextBox x:Name="StartTxt" Text="{Binding StartText}" Margin="141,58,0,0"/>

                    <Button Content="Turn on" Command="{Binding TurnOnCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="224,58,0,0"/>

                    <TextBlock Text="End:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,99,0,0"/>
                    <TextBox x:Name="EndTxt" Text="{Binding EndText}"
                             IsEnabled="{Binding IsWorkTimeMode}" Margin="141,94,0,0"/>

                    <Button Content="Now" Command="{Binding NowCommand}"
                            IsEnabled="{Binding IsWorkTimeMode}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="224,94,0,0"/>

                    <TextBlock Text="Overtime:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,135,0,0"/>
                    <TextBox x:Name="OvertimeTxt" Text="{Binding OvertimeText, Mode=OneWay}" IsReadOnly="True"
                             Margin="141,130,0,0"/>

                    <TextBlock Text="Maximum:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,171,0,0"/>
                    <TextBox x:Name="MaxTimeTxt" Text="{Binding MaximumWorkTimeText, Mode=OneWay}" IsReadOnly="True"
                             Margin="141,166,0,0"/>

                    <TextBlock Text="{Binding StatusText}" Foreground="Red" FontSize="11" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Margin="0,203,0,0"/>

                    <Button Content="Calculate" Command="{Binding CalculateCommand}"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,235,0,0"/>
                </Grid>
            </TabItem>

            <!-- Tab 2: Umrechner -->
            <TabItem Header="Work Time Converter">
                <Grid>
                    <TextBlock Text="TODO" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Margin="0,20,0,0"/>

                    <!-- Hier kommen deine Umrechner-Controls rein -->
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
