<Window x:Class="WorkTimeCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorkTimeCalculator"
        mc:Ignorable="d"
        Title="Work Time Calculator" Height="350" Width="350">
    
 <Grid>
        <TextBlock Text="Work Time Calculator" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,50,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,101,0,0">
            <RadioButton Content="Calculate Work Time" IsChecked="{Binding IsWorkTimeMode}" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <RadioButton Content="Calculate Go Home Time" IsChecked="{Binding IsGoHomeTimeMode}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="Start:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="21,144,0,0"/>
        <TextBox x:Name="StartTxt" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                 Width="76" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="116,139,0,0"/>

        <Button Content="Turn on" Command="{Binding TurnOnCommand}"
                Width="74" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="199,139,0,0"/>

        <TextBlock Text="End:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="21,180,0,0"/>
        <TextBox x:Name="EndTxt" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsWorkTimeMode}"
                 Width="76" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="116,175,0,0"/>

        <Button Content="Now" Command="{Binding NowCommand}"
                IsEnabled="{Binding IsWorkTimeMode}"
                Width="74" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="199,175,0,0"/>

        <TextBlock Text="Overtime:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="21,216,0,0"/>
        <TextBox x:Name="OvertimeTxt" Text="{Binding OvertimeText, Mode=OneWay}" IsReadOnly="True"
                 Width="76" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="116,211,0,0"/>

        <Button Content="Calculate" Command="{Binding CalculateCommand}"
                Width="74" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,259,0,0"/>

        <TextBlock Text="{Binding StatusText}" Foreground="Red" FontSize="11" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Margin="0,289,0,0"/>
    </Grid>
</Window>