<Window x:Class="WorkTimeCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorkTimeCalculator"
        mc:Ignorable="d"
        Title="Work Time Calculator" Height="400" Width="350" ResizeMode="CanMinimize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Überschrift über den Registerkarten -->
        <TextBlock Grid.Row="0" Text="Work Time Calculator" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10,0,10"/>

        <TabControl Grid.Row="1">

            <!-- Tab 1: Work Time -->
            <TabItem Header="Work Time Calculator">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                        <RadioButton Content="Calculate Work Time" IsChecked="{Binding IsWorkTimeMode}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <RadioButton Content="Calculate Go Home Time" IsChecked="{Binding IsGoHomeTimeMode}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Start:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,63,0,0"/>
                    <TextBox x:Name="StartTxt" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                             Width="76" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,58,0,0"/>

                    <Button Content="Turn on" Command="{Binding TurnOnCommand}"
                            Width="74" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="224,58,0,0"/>

                    <TextBlock Text="End:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,99,0,0"/>
                    <TextBox x:Name="EndTxt" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsWorkTimeMode}"
                             Width="76" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,94,0,0"/>

                    <Button Content="Now" Command="{Binding NowCommand}"
                            IsEnabled="{Binding IsWorkTimeMode}"
                            Width="74" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="224,94,0,0"/>

                    <TextBlock Text="Overtime:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,135,0,0"/>
                    <TextBox x:Name="OvertimeTxt" Text="{Binding OvertimeText, Mode=OneWay}" IsReadOnly="True"
                             Width="76" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,130,0,0"/>

                    <TextBlock Text="Maximum:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,171,0,0"/>
                    <TextBox x:Name="MaxTimeTxt" Text="{Binding MaximumWorkTimeText, Mode=OneWay}" IsReadOnly="True"
                             Width="76" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,166,0,0"/>

                    <TextBlock Text="{Binding StatusText}" Foreground="Red" FontSize="11" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Margin="0,203,0,0"/>

                    <Button Content="Calculate" Command="{Binding CalculateCommand}"
                            Width="74" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,235,0,0"/>
                </Grid>
            </TabItem>

            <!-- Tab 2: Umrechner -->
            <TabItem Header="Work Time Converter">
                <Grid>
                    <TextBlock Text="TODO" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Margin="0,20,0,0"/>

                    <!-- Hier kommen deine Umrechner-Controls rein -->
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>